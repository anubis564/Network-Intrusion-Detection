# Copy this file to .streamlit/secrets.toml (never commit the real file)
# or paste the same lines into Streamlit Cloud > App settings > Secrets.
GEMINI_API_KEY = "your-gemini-api-key"
# Optional: pin a Gemini model. Leave it out and the app picks the newest Flash model your key can use,
# moving to the next one automatically if a model is retired or overloaded.
# GEMINI_MODEL = "gemini-3.8-flash"
